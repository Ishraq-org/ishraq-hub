{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@ishraq/shared-types": ["./../../packages/shared-types/dist/index.d.ts"],
      "@ishraq/shared-types/*": ["./../../packages/shared-types/dist/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
