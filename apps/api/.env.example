# ==========================================
# ISHRAQ HUB API — ENVIRONMENT VARIABLES
# ==========================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/ishraq-hub

# Frontend Client URL (Used for CORS and Auth redirects)
CLIENT_URL=https://ishraq-hub.netlify.app

# JWT Secret Key (Use a strong 64-character random string in production)
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789

# Resend Email API Credentials (no-reply@ishraqhub.com)
RESEND_API_KEY=re_123456789_your_resend_api_key
RESEND_FROM_EMAIL=no-reply@ishraqhub.com

# Google OAuth2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://ishraq-hub-api.onrender.com/api/auth/google/callback

# Cloudinary Upload Infrastructure Credentials (From Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Telegram Bot Credentials (From @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
