# ===================================================
# Ishraq Hub — API Environment Variables Configuration
# ===================================================

# Server Port and Node Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/ishraq_hub?retryWrites=true&w=majority

# JWT Secret Key for Session Cookies
# Generate a long random string (e.g. using openssl rand -base64 32)
JWT_SECRET=super_secret_jwt_key_change_this_in_production_12345

# Allowed Client Origin URL for CORS and Auth Redirects
# Local Dev: http://localhost:3000
# Production: https://<your-site-name>.netlify.app
CLIENT_URL=http://localhost:3000

# Google OAuth Credentials (Optional for "Continue with Google")
# Get from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Resend API Key for Email Delivery (Optional)
# Get from Resend.com -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Initial Super Admin Seed Credentials (Used when running npm run seed:admin)
SEED_ADMIN_NAME="Aymen SuperAdmin"
SEED_ADMIN_EMAIL=aymen@ishraqhub.com
SEED_ADMIN_PASSWORD=SuperAdminSecret123!
