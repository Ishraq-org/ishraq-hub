# Base API URL (e.g., https://ishraq-hub-api.onrender.com or empty for local proxy)
VITE_API_URL=https://ishraq-hub-api.onrender.com

# Cloudinary Cloud Name (Publicly safe client variable)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Google AdSense Publisher Client ID (e.g. ca-pub-1234567890123456)
VITE_ADSENSE_CLIENT_ID=
